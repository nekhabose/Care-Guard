# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=CareGuard
APP_VERSION=0.1.0
ENVIRONMENT=development           # development | production
BASE_URL=https://api.careguard.health
DOMAIN=api.careguard.health

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/careguard
# Force TLS to the DB. Leave blank to default ON in production, OFF in dev.
DB_REQUIRE_SSL=

# ── PHI encryption at rest (REQUIRED in production) ─────────────────────────
# PHI columns (names, phone) and call transcripts are Fernet-encrypted before
# they hit the database. Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys for zero-downtime rotation (first one encrypts).
# In dev, leaving this blank uses an INSECURE derived key so things just run.
PHI_KEY_PROVIDER=env              # env | kms
PHI_ENCRYPTION_KEY=
# When PHI_KEY_PROVIDER=kms, PHI_ENCRYPTION_KEY holds the base64 KMS-wrapped key.
PHI_KMS_KEY_ID=

# ── Call recordings (optional; PHI) ─────────────────────────────────────────
# When enabled, recordings are copied to a KMS-encrypted S3 bucket and purged
# after RECORDING_RETENTION_DAYS. Requires a signed AWS BAA.
RECORDINGS_ENABLED=false
RECORDINGS_S3_BUCKET=
KMS_KEY_ID=
RECORDING_RETENTION_DAYS=90

# ── AWS ─────────────────────────────────────────────────────────────────────
# Sign HIPAA BAA at: https://aws.amazon.com/artifact/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=careguard-discharge-docs
SNS_ESCALATION_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:careguard-escalations

# ── Escalation alerts ───────────────────────────────────────────────────────
# Which transport sends care-team escalation alerts. Default 'ntfy' is free and
# needs no API key. Alert payloads contain UUIDs only — never PHI.
#   ntfy | telegram | twilio_sms | sns | noop
NOTIFICATION_PROVIDER=ntfy
# ntfy.sh — pick a private, hard-to-guess topic; subscribe in the ntfy app or at
# https://ntfy.sh/<topic>. No signup required.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=careguard-alerts-change-me
# Telegram — create a bot via @BotFather; get chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Twilio SMS — care-team phone number; reuses the Twilio creds below.
ESCALATION_SMS_TO=+15557654321

# ── LLM provider ────────────────────────────────────────────────────────────
# Which model powers the care agent. Switch providers without code changes.
LLM_PROVIDER=claude              # claude | deepseek
LLM_MAX_TOKENS=500

# ── Anthropic (used when LLM_PROVIDER=claude) ───────────────────────────────
# Sign HIPAA BAA at: https://www.anthropic.com/hipaa
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# ── DeepSeek (used when LLM_PROVIDER=deepseek) ──────────────────────────────
# Get API key at: https://platform.deepseek.com/api_keys
# NOTE: DeepSeek does not currently offer a HIPAA BAA — do not send PHI
# through DeepSeek in production until a BAA is in place.
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat     # deepseek-chat | deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Twilio ──────────────────────────────────────────────────────────────────
# Sign HIPAA BAA at: https://www.twilio.com/en-us/hipaa
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567
# Reject inbound Twilio webhooks without a valid X-Twilio-Signature. Auto-skips
# when TWILIO_AUTH_TOKEN is unset (local/mock dev); always on in production.
TWILIO_VALIDATE_SIGNATURES=true

# ── Epic FHIR ───────────────────────────────────────────────────────────────
# FHIR_PROVIDER=mock serves built-in sample patients (no Epic keys required) —
# great for local dev and demos. Switch to 'epic' for live OAuth.
FHIR_PROVIDER=mock                # mock | epic
# Register at: https://open.epic.com
# Sandbox base URL: https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_CLIENT_ID=your-epic-client-id
EPIC_PRIVATE_KEY_PATH=/path/to/your/private-key.pem   # NEVER commit the actual key file

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Initial admin login, created on first startup with an empty users table so the
# dashboard is usable after a fresh deploy. No-ops once any user exists. Leave
# BOOTSTRAP_ADMIN_PASSWORD blank to skip seeding (e.g. if you provision users
# another way). Change the password immediately after first sign-in.
BOOTSTRAP_ADMIN_EMAIL=admin@careguard.local
BOOTSTRAP_ADMIN_NAME=CareGuard Admin
BOOTSTRAP_ADMIN_PASSWORD=

# ── Celery (Redis) ──────────────────────────────────────────────────────────
# Free local broker + result backend. Start Redis: `brew services start redis`
# (or `redis-server`). Broker on db 0, task results on db 1.
# In AWS production you can swap the broker for SQS: CELERY_BROKER_URL=sqs://
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
