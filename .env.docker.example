# Optional overrides for `docker compose up`. Copy to `.env` (compose reads it
# automatically) and edit. Every value has a safe demo default in
# docker-compose.yml, so this file is optional for a local/demo run.

# --- Database ---
POSTGRES_USER=careguard
POSTGRES_PASSWORD=careguard
POSTGRES_DB=careguard

# --- App ---
# development = boots with insecure derived PHI key + weak secrets (demo only).
# production  = fails closed unless real keys/secrets/BAAs are set (see DEPLOYMENT.md).
ENVIRONMENT=development
FHIR_PROVIDER=mock
NOTIFICATION_PROVIDER=noop
LLM_PROVIDER=claude

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-change-me
# First-run admin login for the dashboard. CHANGE THE PASSWORD.
BOOTSTRAP_ADMIN_EMAIL=admin@careguard.health
BOOTSTRAP_ADMIN_NAME=CareGuard Admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# --- Integrations (optional — leave blank for the mock/demo stack) ---
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
